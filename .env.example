# Chatbot / DeepSeek
# Supply LLM_API_KEY locally; it is intentionally empty in this committed template.
LLM_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ENABLE_RAG=false
CHATBOT_BASE_URL=http://chatbot:8000
CHATBOT_CONNECT_TIMEOUT_MS=3000
CHATBOT_READ_TIMEOUT_MS=60000
AI_PROXY_SECRET=
MAX_HISTORY_TURNS=20
SESSION_TTL_SECONDS=3600
MAX_ACTIVE_SESSIONS=10000

# MySQL local-development placeholders
MYSQL_DATABASE=hospital
MYSQL_USER=hospital
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-local-root

# Redis local-development placeholders
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local

# Required by Compose; set a long, unique value in your uncommitted .env file.
JWT_SECRET=
